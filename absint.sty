%% A free name is defined globally (`stubs'), which also makes \lub work in
%% plain math mode and lets the notation survive a moving argument -- without
%% it \absexpr{\Glb S} in a \section expands \Glb into the .toc file.  A taken
%% name goes into \absint@activation, so that only \absexpr sees it.
\newcommand*\absint@activation{}

\newcommand*\absint@stub@[1]{%
  \expandafter\protected\expandafter\gdef\csname #1\endcsname
    {\ensuremath{\absint@use{#1}}}}
\newcommand*\absint@install@[1]{%
  \ifboolexpr{ bool {absint@stubs} and not test {\ifcsdef{#1}} }%
    {\absint@stub@{#1}}{\absint@compile{#1}{\noexpand\absint@use{#1}}}}
%% Indirect on purpose: a command declared in the document body installs its
%% name before \DeclareRobustCommand gets to define it.
\newcommand*\absint@stubcmd@[1]{%
  \begingroup\edef\absint@x{\endgroup
    \noexpand\protected\noexpand\gdef\expandafter\noexpand\csname #1\endcsname
      {\expandafter\noexpand\csname absint@cmd@#1\endcsname}}%
  \absint@x}
\newcommand*\absint@installcmd@[1]{%
  \ifboolexpr{ bool {absint@stubs} and not test {\ifcsdef{#1}} }%
    {\absint@stubcmd@{#1}}%
    {\absint@compile{#1}{\expandafter\noexpand\csname absint@cmd@#1\endcsname}}}

\newcommand*\absint@compile[2]{%
  \begingroup\edef\absint@x{\endgroup
    \noexpand\gappto\noexpand\absint@activation{%
      \noexpand\def\expandafter\noexpand\csname #1\endcsname{#2}}}%
  \absint@x}

\newcommand*\absint@strip@[1]{\csdef{#1}{}}
\newcommand*\absint@stripall{%
  \forlistloop\absint@strip@\absint@symbols
  \forlistloop\absint@strip@\absint@commands}

\AtBeginDocument{%
  \forlistloop\absint@install@\absint@symbols
  \forlistloop\absint@installcmd@\absint@commands
  \absint@readytrue
  %% notation cannot be rendered in a PDF bookmark, so strip it there
  \ifcsname pdfstringdefDisableCommands\endcsname
    \pdfstringdefDisableCommands{%
      \let\absexpr\@firstofone \let\absintuse\@gobble \let\absintmark\@gobble
      \let\absint\@empty \let\endabsint\@empty \absint@stripall}%
  \fi}

\endinput
