\NeedsTeXFormat{LaTeX2e}[2022/06/01]
\ProvidesPackage{absint}[2026/09/20 v2.0 Notation for Abstract Interpretation]

\RequirePackage{amsmath}
\@ifundefined{varnothing}{\RequirePackage{amssymb}}{}% clashes with newtx & co.
\@ifundefined{mathbb}{\RequirePackage{amsfonts}}{}
\RequirePackage{etoolbox}
\RequirePackage{graphicx}% \rotatebox, for the \bigsqcap fallback
\RequirePackage{xcolor}%  \color and \mathcolor

\newif\ifabsint@colored  \absint@coloredtrue
\newif\ifabsint@links    \absint@linkstrue
\newif\ifabsint@track    \absint@tracktrue
\newif\ifabsint@stubs    \absint@stubstrue

\newif\ifabsint@mathcolor

\def\absint@color{purple}          \def\absint@sharp{\#}
\def\absint@labelprefix{absint:}   \def\absint@flat{}
\def\absint@brackets{auto}         \def\absint@subst{assign}
\newcommand*\absint@op{\mathsf}    \newcommand*\absint@bb{\mathbb}
\newcommand*\absint@cal{\mathcal}

\DeclareKeys[absint]{
  color       .store = \absint@color       ,
  colored     .if    = absint@colored      ,
  mathcolor   .if    = absint@mathcolor    ,
  style       .store = \absint@style@      ,
  links       .if    = absint@links        ,
  labelprefix .store = \absint@labelprefix ,
  track       .if    = absint@track        ,
  sharp       .store = \absint@sharp       ,
  flat        .store = \absint@flat        ,
  brackets    .store = \absint@brackets    ,
  substitution .store = \absint@subst      ,
  opfont      .store = \absint@op          ,
  domainfont  .store = \absint@bb          ,
  calfont     .store = \absint@cal         ,
  stubs       .if    = absint@stubs        ,
  shortcut    .code  = {\csdef{#1}{\absexpr}} ,
  plain       .code  = {\absint@coloredfalse\absint@linksfalse} ,
  plain       .default:n = true
}

%% \mathcolor is only needed to colour the scripts after a symbol, and costs
%% about a fifth of the runtime; a math group with \color does not.
\newcommand*\absint@docolor[1]{%
  \ifabsint@mathcolor
    \expandafter\absint@mathcolor@\else\expandafter\absint@plaincolor@\fi{#1}}
\newcommand*\absint@plaincolor@[1]{{\color{\absint@color}#1}}
\newcommand*\absint@mathcolor@[1]{\mathcolor{\absint@color}{#1}}
\def\absint@style@#1{% `style' created it, so \def rather than \newcommand
  \ifabsint@colored\expandafter\absint@docolor\else\expandafter\@firstofone\fi{#1}}
\newcommand*\absintstyle[1]{\absint@style@{#1}}

\ProcessKeyOptions[absint]
\newcommand*\absintsetup[1]{\SetKeys[absint]{#1}}

\ifdefstring{\absint@brackets}{stmaryrd}{\RequirePackage{stmaryrd}}{}
\newcommand*\absint@lbrack{[\mkern-3.2mu[}
\newcommand*\absint@rbrack{]\mkern-3.2mu]}

%% \bigsqcap exists in stmaryrd and friends only; otherwise turn \bigsqcup over.
\newcommand*\absint@bigsqcap@[2]{%
  \vcenter{\hbox{\rotatebox[origin=c]{180}{$\m@th#1\bigsqcup$}}}}
\newcommand*\absint@bigsqcap{\mathop{\mathpalette\absint@bigsqcap@\relax}}

\newcommand*\absint@stack[2]{\mathpalette{\absint@stack@{#1}{#2}}\relax}
\newcommand*\absint@stack@[4]{%
  \vcenter{\m@th\baselineskip\z@skip\lineskip.2ex\lineskiplimit\maxdimen
    \ialign{\hfil$#3##$\hfil\cr#1\cr#2\cr}}}

\AtBeginDocument{%
  \ifcsname bigsqcap\endcsname\let\absint@bigsqcap\bigsqcap\fi
  \ifdefstring{\absint@brackets}{fallback}{}{%
    \ifcsname llbracket\endcsname
      \let\absint@lbrack\llbracket \let\absint@rbrack\rrbracket
    \fi}%
  \ifabsint@links\ifcsname hyperref\endcsname\else\absint@linksfalse\fi\fi}

\newcommand*\absint@symbols{}
\newcommand*\absint@commands{}
\newif\ifabsint@ready % is the notation installed yet?

\DeclareKeys[absint/symbol]{
  class    .store = \absint@sym@class ,
  abstract .store = \absint@sym@abs   ,
  sharp    .if    = absint@sym@sharp  ,
  aliases  .store = \absint@sym@alias ,
  desc     .store = \absint@sym@desc
}
\@for\absint@tmp:=ord,bin,rel,op,open,close,punct,inner\do{%
  \edef\absint@tmp@{\noexpand\DeclareKeys[absint/symbol]%
    {\absint@tmp .meta:n = {class=\absint@tmp}}}\absint@tmp@}

\NewDocumentCommand\DeclareAbsintSymbol{mmO{}}{%
  \def\absint@sym@class{ord}\def\absint@sym@abs{}\absint@sym@sharpfalse
  \def\absint@sym@alias{}\def\absint@sym@desc{}%
  \SetKeys[absint/symbol]{#3}\absint@declare{#1}{#2}}

\newcommand*\absint@declare[2]{%
  \ifcsdef{absint@code@#1}{\absint@twice{#1}}{\listgadd\absint@symbols{#1}}%
  \ifcsname #1\endcsname\csletcs{absint@orig@#1}{#1}\fi
  \ifblank{#2}{%
    \ifcsname absint@orig@#1\endcsname
      \csdef{absint@code@#1}{\csuse{absint@orig@#1}}%
    \else
      \PackageError{absint}{Cannot lift the undefined command
        \expandafter\string\csname#1\endcsname}%
        {Pass an explicit meaning as the second argument.}%
    \fi
  }{\csdef{absint@code@#1}{#2}}%
  \ifdefempty\absint@sym@abs{%
    \ifabsint@sym@sharp
      \csdef{absint@abs@#1}{{\csuse{absint@code@#1}}^{\absint@sharp}}%
      \csgdef{absint@hasabs@#1}{}%
    \else\csletcs{absint@abs@#1}{absint@code@#1}\fi
  }{\csedef{absint@abs@#1}{\unexpanded\expandafter{\absint@sym@abs}}%
    \csgdef{absint@hasabs@#1}{}}%
  \ifcsname math\absint@sym@class\endcsname
    \csletcs{absint@class@#1}{math\absint@sym@class}%
  \else
    \PackageError{absint}{Unknown math class `\absint@sym@class' of `#1'}%
      {Use one of ord, bin, rel, op, open, close, punct and inner.}%
  \fi
  \csdef{absint@ref@#1}{#1}%
  \csedef{absint@desc@#1}{\unexpanded\expandafter{\absint@sym@desc}}%
  \ifabsint@ready\absint@install@{#1}\fi
  \ifdefempty\absint@sym@alias{}{%
    \def\absint@alias@##1{\DeclareAbsintAlias{##1}{#1}}%
    \expandafter\forcsvlist\expandafter\absint@alias@
      \expandafter{\absint@sym@alias}}}

\newcommand*\absint@twice[1]{%
  \PackageWarning{absint}{`#1' is declared twice, using the new one}}

\newcommand*\DeclareAbsintAlias[2]{%
  \ifcsdef{absint@code@#2}{%
    \ifcsdef{absint@code@#1}{\absint@twice{#1}}{\listgadd\absint@symbols{#1}}%
    \def\do##1{\csletcs{absint@##1@#1}{absint@##1@#2}}%
    \docsvlist{code,abs,class,ref,desc}%
    \csgdef{absint@isalias@#1}{}\listcsgadd{absint@aliases@#2}{#1}%
    \ifabsint@ready\absint@install@{#1}\fi
  }{\PackageError{absint}{Cannot alias the unknown symbol `#2'}%
     {Declare `#2' with \string\DeclareAbsintSymbol\space first.}}}

\DeclareKeys[absint/command]{
  desc .store = \absint@c@desc ,
  demo .store = \absint@c@demo
}
\newcommand*\DeclareAbsintCommand[2][]{%
  \def\absint@c@desc{}\def\absint@c@demo{}\SetKeys[absint/command]{#1}%
  \ifcsdef{absint@cmd@#2}{\absint@twice{#2}}{\listgadd\absint@commands{#2}}%
  \csedef{absint@cdesc@#2}{\unexpanded\expandafter{\absint@c@desc}}%
  \csedef{absint@cdemo@#2}{\unexpanded\expandafter{\absint@c@demo}}%
  \csedef{absint@csrc@#2}{\detokenize\expandafter{\absint@c@demo}}%
  \ifabsint@ready\absint@installcmd@{#2}\fi
  \expandafter\DeclareRobustCommand\csname absint@cmd@#2\endcsname}

%% Restoring the math class explicitly: styling and linking would otherwise
%% turn every symbol into an Ord atom and ruin its spacing.
\newif\ifabsint@abstract
\newif\ifabsint@rendering % guards against nested styling and linking

\newcommand*\absint@use[1]{%
  \ifabsint@rendering\csuse{absint@code@#1}\else\absint@render{#1}\fi}
\newcommand*\absint@render[1]{%
  \absint@track{#1}%
  \csuse{absint@class@#1}{%
    \absint@link{#1}{\absintstyle{\absint@renderingtrue\absint@payload{#1}}}}}
\newcommand*\absint@payload[1]{%
  \ifabsint@abstract\csuse{absint@abs@#1}\else\csuse{absint@code@#1}\fi}

%% \absint@activation is compiled once, so entering the notation costs a
%% fixed list of assignments and nothing else.
\DeclareRobustCommand*\absint{\begingroup\absint@activation}
\def\endabsint{\endgroup}% \newcommand refuses \end... names
\DeclareRobustCommand*\absexpr[1]{\ensuremath{\absint#1\endabsint}}
\DeclareRobustCommand*\absintuse[1]{%
  \ifcsdef{absint@code@#1}{\ensuremath{\absint@use{#1}}}{\absint@unknown{#1}}}
\newcommand*\absint@unknown[1]{\PackageWarning{absint}{Unknown symbol `#1'}}

%% Only link a symbol whose target really exists: no undefined references.
\newcommand*\absint@labelof[1]{\absint@labelprefix\csuse{absint@ref@#1}}
\newcommand*\absint@link[2]{%
  \ifabsint@links
    \ifcsdef{r@\absint@labelof{#1}}{\hyperref[\absint@labelof{#1}]{#2}}{#2}%
  \else#2\fi}

\DeclareRobustCommand*\absintmark[1]{\forcsvlist\absint@mark@{#1}\ignorespaces}
\newcommand*\absint@mark@[1]{%
  \ifcsdef{absint@code@#1}{%
    \ifcsdef{absint@marked@#1}{\PackageWarning{absint}{`#1' is marked twice}}{}%
    \absint@mark@@{#1}%
  }{\absint@unknown{#1}}}
%% \absintlegend skips symbols that already have a target, so a hand placed
%% \absintmark always wins
\newcommand*\absint@markonce[1]{\ifcsdef{absint@marked@#1}{}{\absint@mark@@{#1}}}
\newcommand*\absint@mark@@[1]{%
  \csgdef{absint@marked@#1}{}%
  \@bsphack\ifcsname phantomsection\endcsname\phantomsection\fi
  \label{\absint@labelof{#1}}\@esphack}

%% Collected globally and written out in one go at the end: writing them where
%% they occur loses every symbol rendered in a box that is only measured and
%% thrown away -- as amsmath does in \overset.
\newcommand*\absint@written{}
\newcommand*\absint@@used[1]{\csgdef{absint@known@#1}{}}
\newcommand*\absint@track[1]{%
  \ifabsint@track
    \ifcsdef{absint@written@#1}{}{%
      \csgdef{absint@written@#1}{}%
      \csgdef{absint@written@\csuse{absint@ref@#1}}{}%
      \listxadd\absint@written{\csuse{absint@ref@#1}}}%
  \fi}
\newcommand*\absint@writeused[1]{\immediate\write\@auxout{\string\absint@@used{#1}}}
\newif\ifabsint@rerun
\newcommand*\absint@checkused[1]{%
  \ifcsdef{absint@isalias@#1}{}{%
    \ifcsdef{absint@written@#1}%
      {\ifcsdef{absint@known@#1}{}{\absint@reruntrue}}%
      {\ifcsdef{absint@known@#1}{\absint@reruntrue}{}}}}
\AtEndDocument{%
  \ifabsint@track
    \if@filesw\forlistloop\absint@writeused\absint@written\fi
    \forlistloop\absint@checkused\absint@symbols
    \ifabsint@rerun
      \PackageWarning{absint}{Symbol usage has changed.  Rerun LaTeX to get
        the notation legend and the symbol links right}%
    \fi
  \fi}

\newcommand*\absintlegendstart{\begin{description}}
\newcommand*\absintlegendstop{\end{description}}
\newcommand*\absintlegendempty{}% nothing to list, e.g. on the first run
\newcommand*\absintlegendentry[4]{% symbol, name, description, aliases
  \item[#1] #2\ifblank{#3}{}{ --- #3}\ifblank{#4}{}{ \textup{(also #4)}}}

\newif\ifabsint@any
\newcommand*\absint@mode{used}
\newcommand*\absintlegend{\@ifstar{\absint@legend{all}}{\absint@legend{used}}}
\newcommand*\absint@legend[1]{%
  \begingroup
    \absint@linksfalse \absint@trackfalse \absint@anyfalse \def\absint@mode{#1}%
    \forlistloop\absint@count@\absint@symbols
    \ifabsint@any
      \absintlegendstart\forlistloop\absint@entry@\absint@symbols\absintlegendstop
    \else\absintlegendempty\fi
  \endgroup}
\newcommand*\absint@listed[3]{% <name>{<listed>}{<not listed>}
  \ifcsdef{absint@isalias@#1}{#3}{%
    \ifdefstring\absint@mode{all}{#2}{\ifcsdef{absint@known@#1}{#2}{#3}}}}
\newcommand*\absint@count@[1]{\absint@listed{#1}{\absint@anytrue}{}}
\newcommand*\absint@entry@[1]{\absint@listed{#1}{\absint@print@{#1}}{}}
\newcommand*\absint@print@[1]{%
  \ifcsdef{absint@aliases@#1}%
    {\absint@print@@{#1}{\absint@showaliases{#1}}}{\absint@print@@{#1}{}}}
\newcommand*\absint@print@@[2]{%
  \absintlegendentry{\absint@markonce{#1}\absint@showsymbol{#1}}%
    {\absintname{#1}}{\csuse{absint@desc@#1}}{#2}}

\newcommand*\absintname[1]{\texttt{\symbol{92}#1}}
\newcommand*\absint@showsymbol[1]{% concrete, and abstract if it differs
  \ensuremath{\absint@raw{absint@code@#1}{#1}%
    \ifcsdef{absint@hasabs@#1}{,\;\absint@raw{absint@abs@#1}{#1}}{}}}
\newcommand*\absint@raw[2]{%
  \csuse{absint@class@#2}{\absintstyle{\absint@renderingtrue\csuse{#1}}}}
\newcommand*\absint@showaliases[1]{%
  \begingroup
    \def\absint@sep{}%
    \def\do##1{\absint@sep\absintname{##1}\def\absint@sep{,\space}}%
    \forlistcsloop\do{absint@aliases@#1}%
  \endgroup}

\newcommand*\absintdemo[1]{\texttt{#1}}
\newcommand*\absintcommands{%
  \begingroup
    \absint@linksfalse \absint@trackfalse
    \absintlegendstart
    \forlistloop\absint@centry@\absint@commands
    \absintlegendstop
  \endgroup}
\newcommand*\absintcommandentry[4]{% example, name, description, source
  \item[#1] #2\ifblank{#3}{}{ --- #3}\ifblank{#4}{}{ \textup{(#4)}}}
\newcommand*\absint@centry@[1]{%
  \absintcommandentry{\absexpr{\csuse{absint@cdemo@#1}}}{\absintname{#1}}%
    {\csuse{absint@cdesc@#1}}{\absint@showdemo{#1}}}
\newcommand*\absint@showdemo[1]{\absintdemo{\csuse{absint@csrc@#1}}}

\newcommand*\absintforallsymbols[1]{\forlistloop#1\absint@symbols}
\newcommand*\absintforallcommands[1]{\forlistloop#1\absint@commands}
\newcommand*\absintapi{%
  absexpr,absint,endabsint,absintuse,absintmark,absintsetup,absintstyle,%
  absintlegend,absintcommands,absintdemo,absintlegendstart,absintlegendstop,%
  absintlegendentry,absintlegendempty,absintcommandentry,absintname,%
  absintforallsymbols,%
  absintforallcommands,DeclareAbsintSymbol,DeclareAbsintAlias,%
  DeclareAbsintCommand}

%% \begingroup on purpose: unlike {...} it does not turn the content into an
%% Ord atom, so the spacing of the relations inside stays intact.
\DeclareAbsintCommand[desc={switch to the abstract world},
  demo={\abstractly{a \lub b}}]{abstractly}[1]{%
    \begingroup\absint@abstracttrue#1\endgroup}
\DeclareAbsintCommand[desc={switch to the concrete world},
  demo={\concretely{a \lub b}}]{concretely}[1]{%
    \begingroup\absint@abstractfalse#1\endgroup}
\DeclareAbsintCommand[desc={the abstraction mark}, demo={X\isAbstract}]%
  {isAbstract}{^{\absintstyle{\absint@sharp}}}
\DeclareAbsintCommand[desc={the concretion mark}, demo={X\isConcrete}]%
  {isConcrete}{\ifdefempty\absint@flat{}{^{\absintstyle{\absint@flat}}}}
\DeclareAbsintCommand[desc={mark one object as abstract}, demo={\abstract{X}}]%
  {abstract}[1]{{#1}\absint@cmd@isAbstract}
\DeclareAbsintCommand[desc={mark one object as concrete}, demo={\concrete{X}}]%
  {concrete}[1]{{#1}\absint@cmd@isConcrete}

%% Logic
\DeclareAbsintSymbol {lnot}     {}                 [desc={negation}, aliases={neg}]
\DeclareAbsintSymbol {land}     {}                 [bin, desc={conjunction}, aliases={wedge}]
\DeclareAbsintSymbol {lor}      {}                 [bin, desc={disjunction}, aliases={vee}]
\DeclareAbsintSymbol {implies}  {}                 [rel, desc={implication}]
\DeclareAbsintSymbol {iff}      {}                 [rel, desc={bi-implication}]
\DeclareAbsintSymbol {forall}   {}                 [op,  desc={universal quantifier}]
\DeclareAbsintSymbol {exists}   {}                 [op,  desc={existential quantifier}]
\DeclareAbsintSymbol {nexists}  {}                 [op,  desc={there is no}]
\DeclareAbsintSymbol {eq}       {=}                [rel, desc={equality}]
\DeclareAbsintSymbol {neq}      {}                 [rel, desc={inequality}]
\DeclareAbsintSymbol {defeq}    {\overset{\absint@op{def}}{=}}
                                                   [rel, desc={equality by definition}]

%% Sets
\DeclareAbsintSymbol {emptyset} {\varnothing}      [desc={the empty set}]
\DeclareAbsintSymbol {in}       {}                 [rel, desc={membership}]
\DeclareAbsintSymbol {notin}    {}                 [rel, desc={non-membership}]
\DeclareAbsintSymbol {ni}       {}                 [rel, desc={contains}]
\DeclareAbsintSymbol {subset}   {}                 [rel, desc={strict subset}]
\DeclareAbsintSymbol {subseteq} {}                 [rel, desc={subset}]
\DeclareAbsintSymbol {supset}   {}                 [rel, desc={strict superset}]
\DeclareAbsintSymbol {supseteq} {}                 [rel, desc={superset}]
\DeclareAbsintSymbol {cup}      {}                 [bin, sharp, desc={union}, aliases={union}]
\DeclareAbsintSymbol {cap}      {}                 [bin, sharp, desc={intersection}, aliases={intersect}]
\DeclareAbsintSymbol {setminus} {}                 [bin, desc={set difference}]
\DeclareAbsintSymbol {times}    {}                 [bin, desc={cartesian product}]
\DeclareAbsintSymbol {bigcup}   {}                 [op,  sharp, desc={union of a family}, aliases={bigunion}]
\DeclareAbsintSymbol {bigcap}   {}                 [op,  sharp, desc={intersection of a family}, aliases={bigintersect}]
\DeclareAbsintSymbol {powerset} {\absint@cal{P}}   [sharp, desc={powerset}, aliases={P}]
\DeclareAbsintSymbol {finpowerset} {\absint@cal{P}_{\absint@op{fin}}}
                                                   [desc={powerset restricted to the finite subsets}]

%% Orders and lattices
\DeclareAbsintSymbol {sqsubseteq} {}               [rel, sharp, desc={partial order}, aliases={partof}]
\DeclareAbsintSymbol {sqsubset} {}                 [rel, sharp, desc={strict partial order}, aliases={strictpartof}]
\DeclareAbsintSymbol {sqsupseteq} {}               [rel, sharp, desc={inverse partial order}]
\DeclareAbsintSymbol {sqsupset} {}                 [rel, sharp, desc={strict inverse partial order}]
\DeclareAbsintSymbol {leq}      {}                 [rel, desc={less than or equal}, aliases={le}]
\DeclareAbsintSymbol {geq}      {}                 [rel, desc={greater than or equal}, aliases={ge}]
\DeclareAbsintSymbol {sqcup}    {}                 [bin, sharp, desc={least upper bound (join)}, aliases={lub,join}]
\DeclareAbsintSymbol {sqcap}    {}                 [bin, sharp, desc={greatest lower bound (meet)}, aliases={glb,meet}]
\DeclareAbsintSymbol {bigsqcup} {}                 [op,  sharp, desc={least upper bound of a family}, aliases={Lub,Join}]
\DeclareAbsintSymbol {bigsqcap} {\absint@bigsqcap} [op,  sharp, desc={greatest lower bound of a family}, aliases={Glb,Meet}]
\DeclareAbsintSymbol {top}      {}                 [sharp, desc={greatest element}]
\DeclareAbsintSymbol {bot}      {}                 [sharp, desc={least element}]
\DeclareAbsintSymbol {widen}    {\nabla}           [bin, sharp, desc={widening}]
\DeclareAbsintSymbol {narrow}   {\triangle}        [bin, sharp, desc={narrowing}]

%% Functions
\DeclareAbsintSymbol {to}       {}                 [rel, desc={function space}]
\DeclareAbsintSymbol {mapsto}   {}                 [rel, desc={maps to}]
\DeclareAbsintSymbol {monoto}   {\overset{\absint@op{m}}{\absint@orig@to}}
                                                   [rel, desc={monotone function space}]
\DeclareAbsintSymbol {compose}  {\circ}            [bin, desc={function composition}]
\DeclareAbsintSymbol {id}       {\absint@op{id}}   [op,  desc={the identity function}]
\DeclareAbsintSymbol {dom}      {\absint@op{dom}}  [op,  desc={domain of a function}]
\DeclareAbsintSymbol {codom}    {\absint@op{codom}}[op,  desc={codomain of a function}]
\DeclareAbsintSymbol {lfp}      {\absint@op{lfp}}  [op,  desc={least fixpoint}]
\DeclareAbsintSymbol {gfp}      {\absint@op{gfp}}  [op,  desc={greatest fixpoint}]
\DeclareAbsintSymbol {Fix}      {\absint@op{Fix}}  [op,  desc={the fixpoints of a function}]

%% Abstraction
\DeclareAbsintSymbol {abstraction}    {\alpha}     [desc={abstraction function}, aliases={abstr}]
\DeclareAbsintSymbol {concretization} {\gamma}     [desc={concretization function}, aliases={concr}]
\DeclareAbsintSymbol {galois}   {\mathop{\rightleftarrows}\limits^{\alpha}_{\gamma}}
                                                   [rel, desc={Galois connection}]
\DeclareAbsintSymbol {galoisinsertion}
  {\mathop{\absint@stack{\rightarrow}{\twoheadleftarrow}}\limits^{\alpha}_{\gamma}}
                                                   [rel, desc={Galois insertion}]
\DeclareAbsintSymbol {abstractmark}   {\absint@sharp} [desc={the abstraction mark}]

%% Domains
\DeclareAbsintSymbol {N}        {\absint@bb{N}}    [desc={the natural numbers}]
\DeclareAbsintSymbol {Z}        {\absint@bb{Z}}    [desc={the integers}]
\DeclareAbsintSymbol {Q}        {\absint@bb{Q}}    [desc={the rationals}]
\DeclareAbsintSymbol {R}        {\absint@bb{R}}    [desc={the reals}]
\DeclareAbsintSymbol {C}        {\absint@bb{C}}    [desc={the complex numbers}]
\DeclareAbsintSymbol {Bool}     {\absint@bb{B}}    [desc={the booleans}]
\DeclareAbsintSymbol {Universe} {\absint@bb{U}}    [sharp, desc={the universe}]
\DeclareAbsintSymbol {Variables}{\absint@bb{V}}    [sharp, desc={the variables}]
\DeclareAbsintSymbol {NumericDomain}  {\absint@bb{I}}  [sharp, desc={a numeric domain}]
\DeclareAbsintSymbol {BooleanDomain}  {\absint@bb{B}}  [sharp, desc={a boolean domain}]
\DeclareAbsintSymbol {IntervalDomain} {\absint@cal{I}} [sharp, desc={the interval domain}]
\DeclareAbsintSymbol {SetOfStates}    {\absint@cal{D}} [sharp, desc={the states}]
\DeclareAbsintSymbol {Environments}   {\absint@cal{E}} [sharp, desc={the environments}]
\DeclareAbsintSymbol {Environment}    {\rho}           [sharp, desc={an environment}]

%% Operators
\DeclareAbsintSymbol {AnyOp}      {\diamond}      [bin, sharp, desc={an arbitrary operator}]
\DeclareAbsintSymbol {AnyCompare} {\bowtie}       [rel, sharp, desc={an arbitrary comparison}]
\DeclareAbsintSymbol {intadd}     {\oplus}        [bin, sharp, desc={addition in a domain}]
\DeclareAbsintSymbol {intsub}     {\ominus}       [bin, sharp, desc={subtraction in a domain}, aliases={intneg}]
\DeclareAbsintSymbol {intmul}     {\otimes}       [bin, sharp, desc={multiplication in a domain}]
\DeclareAbsintSymbol {intdiv}     {\oslash}       [bin, sharp, desc={division in a domain}]
\DeclareAbsintSymbol {intmod}     {\odot}         [bin, sharp, desc={modulo in a domain}]

%% Semantics
\DeclareAbsintSymbol {RawEvaluateExpr}      {\absint@bb{E}} [sharp, desc={expression semantics}]
\DeclareAbsintSymbol {RawEvaluateCond}      {\absint@bb{C}} [sharp, desc={condition semantics}]
\DeclareAbsintSymbol {RawEvaluateStatement} {\absint@bb{S}} [sharp, desc={statement semantics}]

\DeclareAbsintCommand[desc={by definition}, demo={a \asdef\eq b}]%
  {asdef}[1]{\overset{\absintstyle{\absint@op{def}}}{#1}}
\DeclareAbsintCommand[desc={semantic brackets}, demo={\semantics{e}}]%
  {semantics}[1]{\absintstyle{\absint@lbrack}\,#1\,\absintstyle{\absint@rbrack}}
\DeclareAbsintCommand[desc={expression semantics},
  demo={\EvaluateExpr{e}\Environment}]%
